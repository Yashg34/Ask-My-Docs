{
  "name": "ask-my-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root for Ask-My-Docs. npm install here once — backend/ and frontend/ share the single root node_modules.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend": "npm run dev --workspace backend",
    "frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "install:all": "npm install"
  },
  "dependencies": {
    "katex": "^0.18.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  }
}
