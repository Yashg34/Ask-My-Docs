PORT = 5000
MONGODB_URI = Your MongoDB URI
JWT_SECRET = Create a random 32 digit secret

# Optional: where the ai-research (FastAPI) service lives. Defaults to
# http://127.0.0.1:8000 (the uvicorn default) if not set.
FASTAPI_URL = http://127.0.0.1:8000

# Optional: comma-separated frontend origins allowed to call this API with
# credentials (the auth cookie). If unset, any origin is reflected.
# CORS_ORIGIN = http://localhost:3000