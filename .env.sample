# =============================================================================
# Ask-My-Docs — single repository-root environment file
# =============================================================================
# ONE `.env` lives here (repo root) and is read by EVERY service:
#     backend/   (Node)   -> server.js loads  ../.env , falls back to backend/.env
#     ai-research (Python)-> config.py loads   ../.env (repo root), falls back to its own
#     evaluation/ (Python)-> config.py loads   ../.env (repo root), falls back to its own
#     frontend/  (future) -> point its tooling at this file too (e.g. Vite loadEnv)
#
# Copy this file to `.env` in the repo root and fill in the placeholders below.
# Everything else is already the same default the code falls back to if unset.

# =============================================================================
# BACKEND (Node/Express gateway)        
# =============================================================================
PORT=5000
NODE_ENV=development            # 'production' enables secure/httpOnly cookies
MONGODB_URI=                    # <- fill in
JWT_SECRET=                     # <- fill in, random 32+ char string

FASTAPI_URL=http://127.0.0.1:8000

CORS_ORIGIN=http://localhost:5173   # Vite dev server default

# =============================================================================
# AI RESEARCH PIPELINE (Python/FastAPI)
# =============================================================================
GROQ_API_KEY=                   # <- fill in, cheap-model + evaluator-model (LiteLLM); also used by evaluation/
GEMINI_API_KEY=                 # <- fill in, strong-model (LiteLLM)

HF_TOKEN=           # <- optional

QDRANT_URL=                     # <- fill in, https://your-cluster-id.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=                 # <- fill in
QDRANT_COLLECTION_NAME=master_docs

REDIS_URL=redis://localhost:6379

NEMO_GUARDRAILS_CONFIG_PATH=guardrails
GUARDRAIL_FAIL_MODE=closed      # 'closed' blocks on a safety-check outage; 'open' proceeds
ADMIN_API_TOKEN=

LOGFIRE_TOKEN=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ask-my-docs

ENV=development                 # 'development' enables uvicorn auto-reload
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200
ALLOWED_ORIGINS=*

# =============================================================================
# FRONTEND (future) — add `frontend` to the `workspaces` array in the root
# package.json, and have its tooling read this same root .env.
# =============================================================================
VITE_API_URL=http://localhost:5000
