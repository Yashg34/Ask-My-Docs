# =============================================================================
# Ask-My-Docs AI Research Pipeline — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values.
# All fields marked REQUIRED must be set for the application to start.

# =============================================================================
# LLM Provider Keys
# =============================================================================
# REQUIRED: GROQ API key for cheap-model and evaluator-model (via LiteLLM)
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED: Google Gemini API key for strong-model (via LiteLLM)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Hugging Face token for sentence-transformers model downloads
HF_TOKEN=

# =============================================================================
# Vector Store (Qdrant Cloud, Phase 4+) — REQUIRED
# =============================================================================
# Get your Qdrant Cloud credentials from https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=master_docs

# =============================================================================
# Redis (Job Queue)
# =============================================================================
# OPTIONAL: Redis connection URL for background ingestion job tracking.
# Defaults to local Redis; the app boots and serves queries even if Redis is
# unreachable (only job-status tracking is skipped).
REDIS_URL=redis://localhost:6379

# =============================================================================
# Guardrails (Phase 2+: NeMo Guardrails)
# =============================================================================
# Path to NeMo Guardrails config directory (contains config.yml and rails/*.co)
NEMO_GUARDRAILS_CONFIG_PATH=guardrails

# Guardrail behavior when an input/context-safety check errors (outage).
# "closed" (default) = block with a "safety check unavailable" message;
# "open" = log + count (guardrail_unavailable) and let the query proceed.
GUARDRAIL_FAIL_MODE=closed

# Optional admin token for the soft-config endpoints (GET/PATCH /config).
# Leave empty to keep them open for local dev; set a value before exposing
# ai-research outside localhost. Sent as `X-Admin-Token`.
ADMIN_API_TOKEN=

# =============================================================================
# Observability (Phase 6+: Logfire + LangSmith)
# =============================================================================
# Logfire: general app/service observability (latency, errors, counters)
# Leave empty to disable Logfire (app runs without it)
LOGFIRE_TOKEN=

# LangSmith: LLM/graph-specific tracing (prompts, completions, chain-of-nodes)
# Set to true to enable LangChain/LangGraph tracing (requires LANGSMITH_API_KEY)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ask-my-docs

# =============================================================================
# App Configuration
# =============================================================================
# Environment mode: 'development' enables uvicorn auto-reload
ENV=production

# Retrieval parameters (Phase 5+ optimized for FlashRank)
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5

# Document chunking parameters
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# CORS Configuration
# Comma-separated list of allowed origins, or '*' for all
ALLOWED_ORIGINS=*
